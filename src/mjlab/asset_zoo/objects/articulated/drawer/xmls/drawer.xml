<?xml version="1.0"?>
<!--
  Open-Drawer mechanism (CL-V2, W2-b).  A 450 x 400 x 465 mm light-oak bedside cabinet
  with one working drawer over a fixed cupboard door, 18 mm panels, 160 mm-centres
  square-bar steel pulls.  Built procedurally (see PROVENANCE.md); textures ambientCG
  Wood048 / Metal032 (CC0).

  Frozen interface: drawer_base (mocap), handle body, drawer_slide (-0.25..0 m),
  geoms drawer_body / drawer_panel / handle, sites base_site / object_site at
  (-0.04, 0, 0).  The drawer front's face (x=-0.02) and the bar's rear face (x=-0.03)
  keep the 10 mm hook slot the classical teacher relies on.
-->
<mujoco model="drawer">
  <compiler angle="radian" meshdir="assets" texturedir="assets"/>

  <asset>
    <texture name="oak_tex" type="2d" file="oak.png"/>
    <material name="oak" texture="oak_tex" specular="0.12" shininess="0.25" reflectance="0.0"/>
    <texture name="steel_tex" type="2d" file="steel.png"/>
    <material name="steel" texture="steel_tex" specular="0.7" shininess="0.6" reflectance="0.15"/>
    <mesh name="drawer_carcass" file="drawer_carcass.obj"/>
    <mesh name="drawer_case_pull" file="drawer_case_pull.obj"/>
    <mesh name="drawer_front" file="drawer_front.obj"/>
    <mesh name="drawer_pull" file="drawer_pull.obj"/>
  </asset>

  <worldbody>
    <body name="drawer_base" pos="0.65 0 0.5" mocap="true">
      <geom name="drawer_carcass_visual" type="mesh" mesh="drawer_carcass" material="oak" contype="0" conaffinity="0" group="2" mass="0"/>
      <geom name="drawer_case_pull_visual" type="mesh" mesh="drawer_case_pull" material="steel" contype="0" conaffinity="0" group="2" mass="0"/>
      <geom name="drawer_body" type="box" pos="0.1900 0.0000 0.1400" size="0.1900 0.2300 0.0100" group="3" rgba="0.5 0.5 0.5 0.25" condim="3" friction="1 0.03 0.003" contype="2" conaffinity="1" solref="0.01 1"/>
      <geom name="drawer_case_left" type="box" pos="0.1900 0.2160 -0.0750" size="0.1900 0.0090 0.2050" group="3" rgba="0.5 0.5 0.5 0.25" condim="3" friction="1 0.03 0.003" contype="2" conaffinity="1" solref="0.01 1"/>
      <geom name="drawer_case_right" type="box" pos="0.1900 -0.2160 -0.0750" size="0.1900 0.0090 0.2050" group="3" rgba="0.5 0.5 0.5 0.25" condim="3" friction="1 0.03 0.003" contype="2" conaffinity="1" solref="0.01 1"/>
      <geom name="drawer_case_rail" type="box" pos="0.1900 0.0000 -0.1160" size="0.1900 0.2070 0.0090" group="3" rgba="0.5 0.5 0.5 0.25" condim="3" friction="1 0.03 0.003" contype="2" conaffinity="1" solref="0.01 1"/>
      <geom name="drawer_case_door" type="box" pos="-0.0100 0.0000 -0.1930" size="0.0100 0.2020 0.0630" group="3" rgba="0.5 0.5 0.5 0.25" condim="3" friction="1 0.03 0.003" contype="2" conaffinity="1" solref="0.01 1"/>
      <!-- Base site at the handle location when the drawer is closed. -->
      <site name="base_site" pos="-0.04 0.0 0.0" size="0.01" rgba="0 0 1 0.3"/>
      <body name="handle">
        <joint name="drawer_slide" type="slide" axis="1 0 0" range="-0.25 0"
               limited="true" damping="0.1"/>
      <geom name="drawer_front_visual" type="mesh" mesh="drawer_front" material="oak" contype="0" conaffinity="0" group="2" mass="0"/>
      <geom name="drawer_pull_visual" type="mesh" mesh="drawer_pull" material="steel" contype="0" conaffinity="0" group="2" mass="0"/>
      <geom name="drawer_panel" type="box" pos="-0.0100 0.0000 0.0000" size="0.0100 0.2000 0.1000" group="3" rgba="0.5 0.5 0.5 0.25" condim="3" friction="1 0.03 0.003" contype="2" conaffinity="1" solref="0.01 1" density="700.0"/>
      <geom name="handle" type="box" pos="-0.0400 0.0000 0.0000" size="0.0100 0.0800 0.0100" group="3" rgba="0.5 0.5 0.5 0.25" condim="3" friction="1 0.03 0.003" contype="2" conaffinity="1" solref="0.01 1" density="2700.0"/>
        <site name="object_site" pos="-0.04 0.0 0" size="0.01 0.01 0.01" rgba="1 0 0 1"/>
      </body>
    </body>
  </worldbody>
</mujoco>
