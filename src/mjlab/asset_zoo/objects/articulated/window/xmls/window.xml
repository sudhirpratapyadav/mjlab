<?xml version="1.0"?>
<!--
  Slide-Window mechanism (CL-V2, W2-b).  A 560 x 440 mm anodised-aluminium horizontal
  slider: one fixed light and one 240 x 360 mm sliding sash on the front track, 4 mm
  glass in both, a 140 mm vertical bar pull on the sash's leading stile.  Built
  procedurally (see PROVENANCE.md); frame texture ambientCG Metal032 (CC0), glass is
  an alpha-blended material (the classic renderer has no refraction).

  Motion profile unchanged: a LATERAL face-push on the pull, +y opens.  Travel is the
  real one — a 240 mm sash in a 480 mm opening slides 240 mm — so range is 0 .. 0.24 m
  with the 0.22 m command target comfortably inside it.

  Frozen interface: window_base (mocap), handle body, window_slide, geoms
  window_body / window_pane / handle, sites base_site / object_site at (-0.04,-0.10,0).
-->
<mujoco model="window">
  <compiler angle="radian" meshdir="assets" texturedir="assets"/>

  <asset>
    <texture name="alu_tex" type="2d" file="alu.png"/>
    <material name="alu" texture="alu_tex" specular="0.6" shininess="0.55" reflectance="0.12"/>
    <material name="glass" rgba="0.62 0.75 0.78 0.30" specular="0.9" shininess="0.85" reflectance="0.25"/>
    <mesh name="window_frame" file="window_frame.obj"/>
    <mesh name="window_glass_fixed" file="window_glass_fixed.obj"/>
    <mesh name="window_sash" file="window_sash.obj"/>
    <mesh name="window_glass_sash" file="window_glass_sash.obj"/>
  </asset>

  <worldbody>
    <body name="window_base" pos="0.65 0 0.5" mocap="true">
      <geom name="window_frame_visual" type="mesh" mesh="window_frame" material="alu" contype="0" conaffinity="0" group="2" mass="0"/>
      <geom name="window_glass_fixed_visual" type="mesh" mesh="window_glass_fixed" material="glass" contype="0" conaffinity="0" group="2" mass="0"/>
      <geom name="window_body" type="box" pos="0.0300 0.3500 0.0000" size="0.0300 0.0200 0.2200" group="3" rgba="0.5 0.5 0.5 0.25" condim="3" friction="1 0.03 0.003" contype="2" conaffinity="1" solref="0.01 1"/>
      <geom name="window_jamb_near" type="box" pos="0.0300 -0.1700 0.0000" size="0.0300 0.0200 0.2200" group="3" rgba="0.5 0.5 0.5 0.25" condim="3" friction="1 0.03 0.003" contype="2" conaffinity="1" solref="0.01 1"/>
      <geom name="window_head" type="box" pos="0.0300 0.0900 0.2000" size="0.0300 0.2400 0.0200" group="3" rgba="0.5 0.5 0.5 0.25" condim="3" friction="1 0.03 0.003" contype="2" conaffinity="1" solref="0.01 1"/>
      <geom name="window_sill" type="box" pos="0.0300 0.0900 -0.2000" size="0.0300 0.2400 0.0200" group="3" rgba="0.5 0.5 0.5 0.25" condim="3" friction="1 0.03 0.003" contype="2" conaffinity="1" solref="0.01 1"/>
      <!-- Base site at the pull when the sash is closed. -->
      <site name="base_site" pos="-0.04 -0.10 0.0" size="0.01" rgba="0 0 1 0.3"/>
      <body name="handle">
        <joint name="window_slide" type="slide" axis="0 1 0" range="0 0.24"
               limited="true" damping="0.1"/>
      <geom name="window_sash_visual" type="mesh" mesh="window_sash" material="alu" contype="0" conaffinity="0" group="2" mass="0"/>
      <geom name="window_glass_sash_visual" type="mesh" mesh="window_glass_sash" material="glass" contype="0" conaffinity="0" group="2" mass="0"/>
      <geom name="window_pane" type="box" pos="0.0060 -0.0250 0.0000" size="0.0120 0.1200 0.1800" group="3" rgba="0.5 0.5 0.5 0.25" condim="3" friction="1 0.03 0.003" contype="2" conaffinity="1" solref="0.01 1" mass="1.05000"/>
      <geom name="handle" type="box" pos="-0.0400 -0.1000 0.0000" size="0.0120 0.0120 0.0700" group="3" rgba="0.5 0.5 0.5 0.25" condim="3" friction="1 0.03 0.003" contype="2" conaffinity="1" solref="0.01 1" mass="0.12000"/>
        <site name="object_site" pos="-0.04 -0.10 0.0" size="0.01 0.01 0.01" rgba="1 0 0 1"/>
      </body>
    </body>
  </worldbody>
</mujoco>
