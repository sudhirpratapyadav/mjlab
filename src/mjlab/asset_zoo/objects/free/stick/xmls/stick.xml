<?xml version="1.0"?>
<!--
  Stick / hook tool (for the tool-pull task).

  Motion profile it serves: TOOL USE. The stick is grasped near its handle end and
  used to drag a puck that is beyond the arm's reach. Two-stage and tool-mediated —
  the policy must first acquire the tool, then reason about contact at the tool's far
  end rather than at its own fingertips.

  Geometry: a long shaft with a short perpendicular hook at the far end, so the puck
  can be caught and pulled back rather than only pushed further away.
-->
<mujoco model="stick">
  <worldbody>
    <body name="stick" pos="0.45 -0.15 0.32">
      <freejoint name="stick_joint"/>
      <!-- Shaft: long axis along world x, grasped near the near (-x) end. -->
      <geom type="box" name="stick_shaft" size="0.13 0.011 0.011" pos="0.0 0 0"
            mass="0.04" condim="3" friction="1 0.03 0.003" rgba="0.75 0.55 0.25 1"
            contype="1" conaffinity="1" solref="0.01 1"/>
      <!-- Hook at the far (+x) end, projecting along +y to catch the puck. -->
      <geom type="box" name="stick_hook" size="0.011 0.035 0.011" pos="0.12 0.035 0"
            mass="0.01" condim="3" friction="1 0.03 0.003" rgba="0.85 0.45 0.15 1"
            contype="1" conaffinity="1" solref="0.01 1"/>
      <!-- Grasp point near the handle end. -->
      <site name="object_site" pos="-0.09 0 0" size="0.01" rgba="1 0 0 1"/>
      <!-- Working point at the hook (used for tool-tip shaping). -->
      <site name="tool_tip_site" pos="0.12 0.02 0" size="0.01" rgba="1 1 0 1"/>
    </body>
  </worldbody>
</mujoco>
