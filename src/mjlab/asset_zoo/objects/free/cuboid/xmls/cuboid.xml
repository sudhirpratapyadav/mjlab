<?xml version="1.0"?>
<!--
  Push / drag / stack-base cuboid: a real gelatin box lying flat.

  Asset: YCB 009_gelatin_box (google_16k scan, CC-BY 4.0), de-rotated 166.85 deg about
  z (76.85 deg to axis-align the scan, +90 deg to put the LONG side across the push
  direction) and used at its native, real scale. See PROVENANCE.md.

  Shared by Push-Cuboid, Drag-Pull and Stack-Cube (the base). Collision is a single
  box, half-extents 0.0365 x 0.0446 x 0.0150, with the body frame at the bbox centre.
  The half-HEIGHT is 0.0150 — identical to the primitive it replaces — so every
  spawn z / goal_z_height / stack z constant is unchanged; only the horizontal
  half-widths move (0.04 square -> 0.0365 x 0.0446), and the teachers now take the
  push-direction support width instead of one constant.

  The extra 90 deg of yaw is deliberate: it puts the 89 mm side across the push
  direction (a wider contact face, more cross-track tolerance for the pusher) and the
  73 mm side along it (a smaller drag-pull engagement inset, so the reachable spawn
  band grows rather than shrinks).

  Mass 0.097 kg is the published product mass — nearly twice the 0.05 kg primitive,
  which is a real change to the sliding friction the push/drag teachers work against.
-->
<mujoco model="cuboid">
  <compiler meshdir="assets" texturedir="assets"/>

  <asset>
    <texture name="cuboid_tex" type="2d" file="cuboid_tex.png"/>
    <material name="cuboid_mat" texture="cuboid_tex" specular="0.15" shininess="0.15"/>
    <mesh name="cuboid_vis" file="cuboid_vis.obj"/>
  </asset>

  <worldbody>
    <body name="cuboid" pos="0.4 0 0.3">
      <freejoint name="cuboid_joint"/>
      <inertial pos="-0.00034 -0.00026 -0.00049" quat="0.708898 -0.003318 -0.000690 -0.705303" mass="0.09700" diaginertia="4.817e-05 6.738e-05 1.028e-04"/>
      <geom name="cuboid_visual" type="mesh" mesh="cuboid_vis" material="cuboid_mat" contype="0" conaffinity="0" group="2" mass="0"/>
      <geom name="cuboid_geom" type="box" pos="0 0 0" size="0.0365 0.0446 0.0150" group="3" rgba="0.5 0.5 0.5 0.3" condim="3" friction="1 0.03 0.003" contype="1" conaffinity="1" solref="0.01 1" mass="0"/>
      <!-- Object site for observations (manipulation point) -->
      <site name="object_site" pos="0 0 0" size="0.01" rgba="1 0 0 1"/>
    </body>
  </worldbody>
</mujoco>
